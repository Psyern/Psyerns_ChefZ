# ChefZ — .gitignore
#
# Scope: apart from the local build-harness folder below, this file only
# ignores content inside the two mod folders.
#   /ChefZ/
#   /ChefZ_Core/
# Everything else (README, ChefZ_Docs, tools, the compatibility mods)
# is deliberately left untouched by these rules.

# Local build harness — tooling, not project source. Stays out of the repo.
/.claude/
/CLAUDE.md

# Internal planning corpus, gate reports and backlogs — kept out of the repo.
/ChefZ_Docs/


# ─────────────────────────────────────────────────────────────
#  /ChefZ_Core/
# ─────────────────────────────────────────────────────────────

# Packed / signed mod output
/ChefZ_Core/**/*.pbo
/ChefZ_Core/**/*.bisign
/ChefZ_Core/**/*.bikey
/ChefZ_Core/**/*.biprivatekey

# Build artifacts (config.cpp is the source, config.bin is generated)
/ChefZ_Core/**/config.bin
/ChefZ_Core/**/build/
/ChefZ_Core/**/Build/
/ChefZ_Core/**/Output/
/ChefZ_Core/**/packed/
/ChefZ_Core/**/temp/
/ChefZ_Core/**/Temp/

# Logs and crash dumps
/ChefZ_Core/**/*.log
/ChefZ_Core/**/*.rpt
/ChefZ_Core/**/*.mdmp
/ChefZ_Core/**/Logs/

# Runtime server data — $profile:ChefZ/ is generated on first server start
/ChefZ_Core/**/profiles/

# Editor / tooling leftovers
/ChefZ_Core/**/*.bak
/ChefZ_Core/**/*.tmp
/ChefZ_Core/**/*~
/ChefZ_Core/**/*.bat
/ChefZ_Core/**/.vs/
/ChefZ_Core/**/.vscode/
/ChefZ_Core/**/*.suo
/ChefZ_Core/**/*.user

# OS
/ChefZ_Core/**/Thumbs.db
/ChefZ_Core/**/Desktop.ini
/ChefZ_Core/**/.DS_Store

# Python bytecode from tooling runs
__pycache__/
