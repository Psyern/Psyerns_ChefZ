{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_BuildBeehiveKit",
            "process": "PROCESS_BUILD_HIVE_KIT",
            "inputs": [
                {
                    "slotId": "planks",
                    "match": {
                        "cls": "WoodenPlank"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 4.0
                    },
                    "consume": "amount",
                    "consumeAmount": 4.0
                },
                {
                    "slotId": "nails",
                    "match": {
                        "cls": "Nail"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 10.0
                    },
                    "consume": "amount",
                    "consumeAmount": 10.0
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_BeehiveKit",
                    "quantity": 1,
                    "quantityMode": "fixed"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_RaiseBeehive",
            "process": "PROCESS_RAISE_HIVE",
            "inputs": [
                {
                    "slotId": "kit",
                    "match": {
                        "cls": "ChefZ_BeehiveKit"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_Beehive",
                    "quantity": 1,
                    "quantityMode": "fixed"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_BuildHoneycombFrame",
            "process": "PROCESS_BUILD_FRAME",
            "inputs": [
                {
                    "slotId": "plank",
                    "match": {
                        "cls": "WoodenPlank"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 1.0
                    },
                    "consume": "amount",
                    "consumeAmount": 1.0
                },
                {
                    "slotId": "nails",
                    "match": {
                        "cls": "Nail"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 2.0
                    },
                    "consume": "amount",
                    "consumeAmount": 2.0
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_HoneycombFrameEmpty"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_BuildUncappingFork",
            "process": "PROCESS_BUILD_UNCAPPING_FORK",
            "inputs": [
                {
                    "slotId": "handle",
                    "match": {
                        "cls": "WoodenPlank"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 1.0
                    },
                    "consume": "amount",
                    "consumeAmount": 1.0
                },
                {
                    "slotId": "tines",
                    "match": {
                        "cls": "Nail"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 4.0
                    },
                    "consume": "amount",
                    "consumeAmount": 4.0
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_UncappingFork",
                    "quantity": 1,
                    "quantityMode": "fixed"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_BuildBeeSmoker",
            "process": "PROCESS_BUILD_BEE_SMOKER",
            "inputs": [
                {
                    "slotId": "body",
                    "match": {
                        "cls": "TunaCan_Opened"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_BeeSmoker",
                    "quantity": 1,
                    "quantityMode": "fixed"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_UncapHoneycombFrame",
            "process": "PROCESS_UNCAP_COMB",
            "inputs": [
                {
                    "slotId": "frame",
                    "match": {
                        "cls": "ChefZ_HoneycombFrameFull"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_HoneycombFrameUncapped"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_ExtendBeehive",
            "process": "PROCESS_EXTEND_HIVE",
            "inputs": [
                {
                    "slotId": "kitA",
                    "match": {
                        "cls": "ChefZ_BeehiveKit"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                },
                {
                    "slotId": "kitB",
                    "match": {
                        "cls": "ChefZ_BeehiveKit"
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_BeehiveDouble"
                }
            ],
            "priority": 0
        },
        {
            "id": "TR_FillBeeSmoker",
            "process": "PROCESS_FILL_SMOKER",
            "_note": "Pfeife stopfen (29.08.2026): eine hoechstens halbvolle Pfeife plus zwei Stueck Rinde ergibt eine volle. Die Pfeife wird als Ganzes ersetzt - eine neue mit voller Fuellung; deshalb die Obergrenze 0.5, damit niemand aus Versehen eine fast volle Pfeife gegen Rinde tauscht.",
            "inputs": [
                {
                    "slotId": "smoker",
                    "match": {
                        "cls": "ChefZ_BeeSmoker",
                        "quantityPct": {
                            "max": 0.5
                        }
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                },
                {
                    "slotId": "bark",
                    "match": {
                        "anyOf": [
                            {
                                "cls": "Bark_Oak"
                            },
                            {
                                "cls": "Bark_Birch"
                            }
                        ]
                    },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": {
                        "min": 2.0
                    },
                    "consume": "amount",
                    "consumeAmount": 2.0
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_BeeSmoker",
                    "quantity": 100,
                    "quantityMode": "fixed"
                }
            ],
            "priority": 0
        }
    ]
}
