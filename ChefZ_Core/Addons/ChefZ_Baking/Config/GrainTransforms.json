{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_FlourWaterToDough",
            "process": "PROCESS_KNEAD",
            "inputs": [
                {
                    "slotId": "flour",
                    "match": { "cls": "ChefZ_Flour" },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "amount",
                    "consumeAmount": 250
                },
                {
                    "slotId": "water",
                    "match": { "isLiquidContainer": true, "liquidType": "Water" },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "amount",
                    "consumeAmount": 150
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_Dough",
                    "quantity": 100,
                    "quantityMode": "fixed",
                    "inheritFreshness": true,
                    "freshnessCarry": 1.0
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "id": "TR_DoughToRawPasta",
            "process": "PROCESS_ROLL",
            "inputs": [
                {
                    "slotId": "dough",
                    "match": { "cls": "ChefZ_Dough" },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_RawPasta",
                    "quantity": 500,
                    "quantityMode": "fixed",
                    "inheritFreshness": true,
                    "freshnessCarry": 1.0
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 10
        },
        {
            "id": "TR_RawPastaToDriedPasta",
            "process": "PROCESS_DRY",
            "stationsAllowed": ["ChefZ_DryingRack"],
            "durationOverrideSec": 1800.0,
            "inputs": [
                {
                    "slotId": "pasta",
                    "match": { "allOf": [ { "cls": "ChefZ_RawPasta" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "none"
                }
            ],
            "outputs": [
                { "setState": "DRIED", "inheritFreshness": true }
            ],
            "qualityRule": "MIN",
            "priority": 0
        }
    ]
}
