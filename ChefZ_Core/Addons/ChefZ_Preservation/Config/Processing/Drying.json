{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_RawSausageToDry",
            "process": "PROCESS_DRY",
            "stationsAllowed": [
                "ChefZ_DryingRack"
            ],
            "durationOverrideSec": 5400,
            "inputs": [
                {
                    "slotId": "sausage",
                    "match": {
                        "allOf": [
                            {
                                "category": "SAUSAGE"
                            },
                            {
                                "state": "RAW"
                            }
                        ]
                    },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_DrySausage",
                    "quantity": 250,
                    "quantityMode": "fixed",
                    "setState": "DRIED",
                    "inheritFreshness": true
                }
            ],
            "freshnessCarry": 1.0,
            "qualityRule": "MIN",
            "priority": 100
        }
    ]
}
