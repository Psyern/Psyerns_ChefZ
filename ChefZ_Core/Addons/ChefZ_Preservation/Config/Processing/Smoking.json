{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_SaltedMeatToSmoked",
            "process": "PROCESS_SMOKE",
            "stationsAllowed": [
                "ChefZ_Smoker"
            ],
            "_note": "durationOverrideSec 31.08.2026 von 1800 auf 300 (Vorgabe Alex: 'vollstaendig raeuchern dauert 5 Minuten' - einheitlich fuer alle drei Transforms dieser Datei, vorher 1800/1500/2400). Der Preis des Raeucherns ist seither nicht mehr die Wartezeit, sondern der Brennstoff: der Raeucherschrank hat seit demselben Tag einen eigenen Brennzustand und verbrennt Rinde aus seinem Cargo (ChefZ_Processing/Scripts/4_World/ChefZ/Preservation/ChefZ_Smoker.c). Fuenf Minuten Vollbrand kosten zwei Stueck Rinde. PROCESS_SMOKE.baseDurationSec steht ebenfalls auf 300 (ChefZ_Processing/config.cpp).",
            "durationOverrideSec": 300,
            "inputs": [
                {
                    "slotId": "meat",
                    "match": {
                        "cls": "ChefZ_SaltedMeat"
                    },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_SmokedMeat",
                    "quantityMode": "fromInput",
                    "setState": "SMOKED",
                    "inheritFreshness": true
                }
            ],
            "freshnessCarry": 1.0,
            "qualityRule": "MIN",
            "priority": 110,
            "_note2": "priority 110 (26.10.2026): vorher Gleichstand mit TR_FishToSmoked, entschieden nur ueber die id (Server-Log). Gepoekeltes geht jetzt immer diesen Weg."
        },
        {
            "id": "TR_RawMeatToSmoked",
            "process": "PROCESS_SMOKE",
            "stationsAllowed": [
                "ChefZ_Smoker"
            ],
            "_note": "26.10.2026: rohes Fleisch ohne Poekeln. Vorher liess der Schrank jedes Fleisch in den Cargo, raeucherte aber nur ChefZ_SaltedMeat - ein Steak lag ewig im brennenden Schrank (Testbericht). Ergebnis ist dasselbe Raeucherfleisch, eine Qualitaetsstufe schlechter als gepoekelt; Wurst und Gepoekeltes haben Vorrang (priority).",
            "durationOverrideSec": 300,
            "inputs": [
                {
                    "slotId": "meat",
                    "match": {
                        "allOf": [
                            {
                                "category": "MEAT"
                            },
                            {
                                "state": "RAW"
                            },
                            {
                                "not": {
                                    "category": "SAUSAGE"
                                }
                            }
                        ]
                    },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_SmokedMeat",
                    "quantityMode": "fromInput",
                    "setState": "SMOKED",
                    "inheritFreshness": true
                }
            ],
            "freshnessCarry": 1.0,
            "qualityRule": "MIN",
            "qualityDelta": -1,
            "priority": 60
        },
        {
            "id": "TR_FishToSmoked",
            "process": "PROCESS_SMOKE",
            "stationsAllowed": [
                "ChefZ_Smoker"
            ],
            "durationOverrideSec": 300,
            "inputs": [
                {
                    "slotId": "fillet",
                    "match": {
                        "allOf": [
                            {
                                "category": "FISH"
                            },
                            {
                                "state": "RAW"
                            }
                        ]
                    },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_SmokedFish",
                    "quantity": 250,
                    "quantityMode": "fixed",
                    "setState": "SMOKED",
                    "inheritFreshness": true
                }
            ],
            "freshnessCarry": 1.0,
            "qualityRule": "MIN",
            "priority": 100
        },
        {
            "id": "TR_RawSausageToSmoked",
            "process": "PROCESS_SMOKE",
            "stationsAllowed": [
                "ChefZ_Smoker"
            ],
            "durationOverrideSec": 300,
            "inputs": [
                {
                    "slotId": "sausage",
                    "match": {
                        "allOf": [
                            {
                                "category": "SAUSAGE"
                            },
                            {
                                "state": "RAW"
                            }
                        ]
                    },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_SmokedSausage",
                    "quantity": 250,
                    "quantityMode": "fixed",
                    "setState": "SMOKED",
                    "inheritFreshness": true
                }
            ],
            "freshnessCarry": 1.0,
            "qualityRule": "MIN",
            "priority": 100
        }
    ]
}
