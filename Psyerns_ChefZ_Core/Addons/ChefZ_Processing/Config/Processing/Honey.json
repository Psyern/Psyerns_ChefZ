{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_SpinHoney",
            "process": "PROCESS_SPIN_HONEY",
            "stationsAllowed": ["ChefZ_HoneyExtractor"],
            "inputs": [
                {
                    "slotId": "frame",
                    "match": { "cls": "ChefZ_HoneycombFrameUncapped" },
                    "minCount": 1,
                    "maxCount": 1,
                    "unit": "PIECE",
                    "amount": { "min": 2.0 },
                    "consume": "amount",
                    "consumeAmount": 1.0
                },
                {
                    "slotId": "jar",
                    "match": { "cls": "ChefZ_EmptyJar" },
                    "minCount": 1,
                    "maxCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "Honey" }
            ],
            "priority": 0
        }
    ]
}
