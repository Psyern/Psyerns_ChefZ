{
  "kind": "transform",
  "schemaVersion": 1,
  "records": [
    {
      "id": "TR_PeppercornsToBlackPepper",
      "process": "PROCESS_GRIND_SPICE",
      "stationsAllowed": ["ChefZ_Mortar"],
      "durationOverrideSec": 20,
      "qualityRule": "MEAN",
      "inputs": [
        { "slotId": "corns", "match": { "cls": "ChefZ_DriedPeppercorns" }, "minCount": 1, "consume": "whole" }
      ],
      "outputs": [
        { "cls": "ChefZ_BlackPepper", "setState": "PREPARED", "quantityMode": "fromInput" }
      ],
      "priority": 100
    },
    {
      "id": "TR_DriedPaprikaToPowder",
      "process": "PROCESS_GRIND_SPICE",
      "stationsAllowed": ["ChefZ_Mortar"],
      "durationOverrideSec": 20,
      "qualityRule": "MEAN",
      "inputs": [
        { "slotId": "pods", "match": { "cls": "ChefZ_DriedPaprika" }, "minCount": 1, "consume": "whole" }
      ],
      "outputs": [
        { "cls": "ChefZ_PaprikaPowder", "setState": "PREPARED", "quantityMode": "fromInput" }
      ],
      "priority": 100
    },
    {
      "id": "TR_HerbMix",
      "process": "PROCESS_GRIND_HERB",
      "stationsAllowed": ["ChefZ_Mortar"],
      "durationOverrideSec": 25,
      "qualityRule": "MEAN",
      "inputs": [
        { "slotId": "thyme",    "match": { "cls": "ChefZ_DriedThyme" },    "minCount": 1, "consume": "whole" },
        { "slotId": "parsley",  "match": { "cls": "ChefZ_DriedParsley" },  "minCount": 1, "consume": "whole" },
        { "slotId": "rosemary", "match": { "cls": "ChefZ_DriedRosemary" }, "minCount": 1, "consume": "whole" }
      ],
      "outputs": [
        { "cls": "ChefZ_HerbMix", "setState": "PREPARED", "quantityMode": "fixed", "quantity": 1 }
      ],
      "priority": 120
    },
    {
      "id": "TR_HunterSeasoning",
      "process": "PROCESS_GRIND_SPICE",
      "stationsAllowed": ["ChefZ_Mortar"],
      "durationOverrideSec": 35,
      "qualityRule": "MEAN",
      "inputs": [
        { "slotId": "pepper",     "match": { "cls": "ChefZ_BlackPepper" },      "minCount": 1, "consume": "whole" },
        { "slotId": "paprika",    "match": { "cls": "ChefZ_PaprikaPowder" },    "minCount": 1, "consume": "whole" },
        { "slotId": "thyme",      "match": { "cls": "ChefZ_DriedThyme" },       "minCount": 1, "consume": "whole" },
        { "slotId": "wildgarlic", "match": { "cls": "ChefZ_DriedWildGarlic" },  "minCount": 1, "consume": "whole" },
        { "slotId": "salt",       "match": { "category": "SPICE" },             "minCount": 1, "consume": "whole" }
      ],
      "outputs": [
        { "cls": "ChefZ_HunterSeasoning", "setState": "PREPARED", "quantityMode": "fixed", "quantity": 1 }
      ],
      "priority": 130
    }
  ]
}
