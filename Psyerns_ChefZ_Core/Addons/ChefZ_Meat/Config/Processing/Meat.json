                { "slotId": "spice1", "match": { "tag": "CHEFZ_SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "spice2", "match": { "tag": "CHEFZ_SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1, "gradePoints": 1 },
