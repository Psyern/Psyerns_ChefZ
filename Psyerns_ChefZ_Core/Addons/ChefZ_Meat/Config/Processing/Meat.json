{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "_comment": "§29: Raw Meat + Knife -> ChefZ_DicedMeat. Der EINZIGE HANDCRAFT-Transform des Moduls - deshalb handcraftRecipeSlots = 1 im CfgChefZ-Knoten. Ein Eingang plus Werkzeuggruppe: genau die Form, die Vanillas RecipeBase traegt (01 V12). vanillaStage statt state, weil die Garstufe eines Vanilla-Steaks unabhaengig von jeder ChefZ-Registry entscheidbar ist.",
            "id": "TR_DicedMeat",
            "process": "PROCESS_CUT_MEAT",
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "category": "MEAT" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_DicedMeat",
                    "quantity": 1,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },

        {
            "_comment": "§30/§57: Meat -> Minced Meat am Fleischwolf. Der gattungsneutrale Fall mit priority 0 - jede Sortenregel unten schlaegt ihn.",
            "id": "TR_MeatToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "category": "MEAT" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_MincedMeat",
                    "quantity": 1,
                    "quantityMode": "fromInput",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "byproducts": [
                {
                    "_comment": "§31: Tierfett faellt beim Wolfen an. Nicht bei jedem Durchgang - chance 0.35 - sonst waere Fett kein Fund, sondern eine Selbstverstaendlichkeit.",
                    "cls": "ChefZ_AnimalFat",
                    "quantity": 1,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "chance": 0.35
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "_comment": "§30: die Sorten. Das Ausgangsfleisch bleibt erkennbar - genau das verlangt §30 (\"Das Ausgangsfleisch sollte intern gespeichert bzw. klassifiziert werden\"). Umgesetzt als eigene Klasse und nicht als Variable am Item: eine Variable haette die Naehrwerte nicht mitgenommen, denn die haengen an Klasse x Garstufe (13 §2).",
            "id": "TR_PorkToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "PigSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedPork", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "byproducts": [
                { "cls": "ChefZ_AnimalFat", "quantity": 1, "quantityMode": "fixed", "setState": "PREPARED", "chance": 0.5 }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
