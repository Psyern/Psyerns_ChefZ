{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [

        {
            "id": "TR_CutBeefLeg",
            "process": "PROCESS_CUT_MEAT",
            "inputs": [
                {
                    "slotId": "leg",
                    "match": { "cls": "ChefZ_BeefLeg" },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "CowSteakMeat", "quantityMode": "fixed" },
                { "cls": "CowSteakMeat", "quantityMode": "fixed" }
            ],
            "byproducts": [
                { "cls": "Bone", "quantityMode": "fixed" }
            ],
            "priority": 20
        },
        {
            "id": "TR_CutPorkLeg",
            "process": "PROCESS_CUT_MEAT",
            "inputs": [
                {
                    "slotId": "leg",
                    "match": { "cls": "ChefZ_PorkLeg" },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "PigSteakMeat", "quantityMode": "fixed" },
                { "cls": "PigSteakMeat", "quantityMode": "fixed" }
            ],
            "byproducts": [
                { "cls": "Lard", "quantityMode": "fixed" }
            ],
            "priority": 20
        },
        {
            "id": "TR_CutVenisonLeg",
            "process": "PROCESS_CUT_MEAT",
            "inputs": [
                {
                    "slotId": "leg",
                    "match": { "cls": "ChefZ_VenisonLeg" },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "DeerSteakMeat", "quantityMode": "fixed" },
                { "cls": "DeerSteakMeat", "quantityMode": "fixed" }
            ],
            "byproducts": [
                { "cls": "Bone", "quantityMode": "fixed" }
            ],
            "priority": 20
        },

        {
            "id": "TR_DicedMeat",
            "process": "PROCESS_CUT_MEAT",
            "_note": "§29: rohes Fleisch + Messer -> Wuerfel. Wieder da seit dem 29.08.2026 (eigenes Modell beefcubes.p3d). Die Keulen matchen ihre eigenen Transforms mit hoeherer Spezifitaet (cls) - dieser hier faengt jedes andere rohe Fleisch.",
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [
                        { "category": "MEAT" },
                        { "vanillaStage": "Raw" },
                        { "state": "RAW" },
                        { "not": { "anyOf": [ { "category": "MINCED_MEAT" }, { "category": "SAUSAGE" } ] } }
                    ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_DicedMeat",
                    "quantity": 250,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "id": "TR_MeatToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "_note": "MENGENSKALA 250 seit dem 31.08.2026: quantity ist eine ROHE Menge, quantityMode fromInput ist hier gestrichen, weil der Eingang Vanilla-Fleisch mit fremder Skala ist. Begruendung in README.md, Abschnitt Mengenskala. SELEKTOR: state RAW plus not(MINCED_MEAT|SAUSAGE) schliessen das eigene Erzeugnis aus - ohne sie wolfte der Wolf sein Hack erneut. Begruendung in README.md, Abschnitt Selbstbezug.",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [
                        { "category": "MEAT" },
                        { "vanillaStage": "Raw" },
                        { "state": "RAW" },
                        { "not": { "anyOf": [ { "category": "MINCED_MEAT" }, { "category": "SAUSAGE" } ] } }
                    ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_MincedMeat",
                    "quantity": 250,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "byproducts": [
                {
                    "cls": "Lard",
                    "quantityMode": "fixed",
                    "chance": 0.35
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "id": "TR_PorkToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "PigSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedPork", "quantity": 250, "quantityMode": "fixed", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "byproducts": [
                { "cls": "Lard", "quantityMode": "fixed", "chance": 0.5 }
