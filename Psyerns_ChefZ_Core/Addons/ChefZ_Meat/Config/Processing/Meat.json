            "inputs": [
                { "slotId": "meat",   "match": { "category": "MINCED_MEAT" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice",  "match": { "tag": "CHEFZ_SPICE" },       "minCount": 1, "consume": "amount", "consumeAmount": 1 },
