{
    "kind": "transform",
    "schemaVersion": 1,
    "records": [
        {
            "id": "TR_DicedMeat",
            "process": "PROCESS_CUT_MEAT",
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "category": "MEAT" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_DicedMeat",
                    "quantity": 1,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },

        {
            "id": "TR_MeatToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "category": "MEAT" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_MincedMeat",
                    "quantity": 1,
                    "quantityMode": "fromInput",
                    "setState": "PREPARED",
                    "inheritFreshness": true
                }
            ],
            "byproducts": [
                {
                    "cls": "ChefZ_AnimalFat",
                    "quantity": 1,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "chance": 0.35
                }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "id": "TR_PorkToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "PigSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedPork", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "byproducts": [
                { "cls": "ChefZ_AnimalFat", "quantity": 1, "quantityMode": "fixed", "setState": "PREPARED", "chance": 0.5 }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
        {
            "id": "TR_VenisonToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "DeerSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedVenison", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
        {
            "id": "TR_BoarToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "BoarSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedBoar", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "byproducts": [
                { "cls": "ChefZ_AnimalFat", "quantity": 1, "quantityMode": "fixed", "setState": "PREPARED", "chance": 0.35 }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
        {
            "id": "TR_ChickenToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "ChickenBreastMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedChicken", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
        {
            "id": "TR_BearToMinced",
            "process": "PROCESS_GRIND_MEAT",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                {
                    "slotId": "meat",
                    "match": { "allOf": [ { "cls": "BearSteakMeat" }, { "vanillaStage": "Raw" } ] },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                { "cls": "ChefZ_MincedBear", "quantity": 1, "quantityMode": "fromInput", "setState": "PREPARED", "inheritFreshness": true }
            ],
            "byproducts": [
                { "cls": "ChefZ_AnimalFat", "quantity": 1, "quantityMode": "fixed", "setState": "PREPARED", "chance": 0.6 }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },

        {
            "id": "TR_SausageCasing",
            "process": "PROCESS_CLEAN_CASING",
            "stationsAllowed": ["ChefZ_CuttingBoard"],
            "inputs": [
                {
                    "slotId": "guts",
                    "match": { "cls": "Guts" },
                    "minCount": 1,
                    "consume": "whole"
                }
            ],
            "outputs": [
                {
                    "cls": "ChefZ_SausageCasing",
                    "quantity": 2,
                    "quantityMode": "fixed",
                    "setState": "PREPARED",
                    "inheritFreshness": true,
                    "freshnessCarry": 0.9
                }
            ],
            "priority": 0
        },

        {
            "id": "TR_RawSausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "category": "MINCED_MEAT" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice",  "match": { "category": "SPICE" },       "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawSausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 0
        },
        {
            "id": "TR_RawPorkSausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "cls": "ChefZ_MincedPork" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice1", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "spice2", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawPorkSausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 20
        },
        {
            "id": "TR_RawVenisonSausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "cls": "ChefZ_MincedVenison" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice",  "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "herb",   "match": { "anyOf": [ { "category": "HERB" }, { "category": "DRIED_HERB" } ] }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawVenisonSausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 30
        },
        {
            "id": "TR_RawBoarSausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "cls": "ChefZ_MincedBoar" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice",  "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "herb",   "match": { "anyOf": [ { "category": "HERB" }, { "category": "DRIED_HERB" } ] }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawBoarSausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 30
        },
        {
            "id": "TR_RawHunterSausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "allOf": [ { "category": "WILD_MEAT" }, { "vanillaStage": "Raw" } ] }, "minCount": 2, "maxCount": 2, "consume": "whole", "gradePoints": 2 },
                { "slotId": "spice1", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "spice2", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1, "gradePoints": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawHunterSausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "qualityDelta": 1.0,
            "priority": 25
        },
        {
            "id": "TR_RawSpicySausage",
            "process": "PROCESS_STUFF_SAUSAGE",
            "stationsAllowed": ["ChefZ_MeatGrinder"],
            "inputs": [
                { "slotId": "meat",   "match": { "category": "MINCED_MEAT" }, "minCount": 1, "consume": "whole" },
                { "slotId": "spice1", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "spice2", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "spice3", "match": { "category": "SPICE" }, "minCount": 1, "consume": "amount", "consumeAmount": 1 },
                { "slotId": "casing", "match": { "cls": "ChefZ_SausageCasing" }, "minCount": 1, "consume": "whole" }
            ],
            "outputs": [
                { "cls": "ChefZ_RawSpicySausage", "quantity": 1, "quantityMode": "fixed", "setState": "RAW", "inheritFreshness": true }
            ],
            "qualityRule": "WEIGHTED_MEAN",
            "priority": 25
        }
    ]
}
